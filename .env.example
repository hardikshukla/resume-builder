# ── Anthropic ────────────────────────────────────────────────────
# Optional server-side key. When unset, users paste their own key in the UI.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used only when an /api/generate request omits `model`. The UI always
# sends the model picked in the selector, so leave this unset unless you call
# the API directly. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── App ──────────────────────────────────────────────────────────
# App version is read from package.json at build time — bump it there.

# ── Sentry (optional error tracking) ─────────────────────────────
# Without a DSN, Sentry stays off. Errors only — performance traces are
# disabled (tracesSampleRate: 0). Browser events are tunnelled through
# /monitoring, which only works for sentry.io DSNs.
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oN.ingest.sentry.io/yyy  # browser + server
# SENTRY_DSN=https://xxx@oN.ingest.sentry.io/yyy              # server-only override

# Optional: upload source maps at build time so stack traces are readable.
# Upload is skipped when SENTRY_AUTH_TOKEN is unset.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=resume-builder

# ── Dropbox (optional) ───────────────────────────────────────────
# Nothing to configure. Dropbox access tokens are entered per-user in the
# UI and live in sessionStorage only — see "Dropbox Setup" in the README.
